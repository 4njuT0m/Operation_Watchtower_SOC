<dashboard version="1.1">
  <label>Operation Watchtower — SOC Overview</label>
  <description>Pipeline health and event volume across all three indexes</description>
  <row>
    <panel>
      <title>Linux Events (24h)</title>
      <single>
        <search>
          <query>index=cybersteps_linux earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <title>Windows Events (24h)</title>
      <single>
        <search>
          <query>index=cybersteps_windows earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <title>Web Events (24h)</title>
      <single>
        <search>
          <query>index=cybersteps_web earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Event Volume Over Time</title>
      <chart>
        <search>
          <query>index=cybersteps_* earliest=-24h | timechart span=1h count by index</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Active Hosts</title>
      <table>
        <search>
          <query>index=cybersteps_* earliest=-24h | dedup host | table host, sourcetype, index</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
      </table>
    </panel>
    <panel>
      <title>Events by Sourcetype</title>
      <chart>
        <search>
          <query>index=cybersteps_* earliest=-24h | stats count by sourcetype | sort -count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>
</dashboard>